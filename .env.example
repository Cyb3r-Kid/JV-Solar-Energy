# JV Solar Energy Pvt Ltd - Environment Configuration Template
PORT=5000
NODE_ENV=development

# Notification Email Target
NOTIFICATION_EMAIL=jv.solarenergy@gmail.com

# SMTP Email Configuration (Optional - in dev mode, notifications log cleanly to console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false

# Optional MongoDB Atlas URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/jvsolar
